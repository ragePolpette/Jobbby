<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GraphEngine\GraphEngine.csproj" />
    <!-- Config, ApplicationLedger and Notifications are compiled into CvExtraction.csproj
         (they have no dedicated project); referencing it is how Host reaches their types. -->
    <ProjectReference Include="..\CvExtraction\CvExtraction.csproj" />
    <ProjectReference Include="..\JobPostings\JobPostings.csproj" />
    <ProjectReference Include="..\Matching\Matching.csproj" />
    <ProjectReference Include="..\Reporting\Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Config\sources.json" Link="sources.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="cv.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <UserSecretsId>64c15329-c5ef-4981-9ab4-6036a26843d6</UserSecretsId>
  </PropertyGroup>

</Project>
