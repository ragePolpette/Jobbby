<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GraphEngine\GraphEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <!-- src/Config and src/ApplicationLedger are not their own projects; their source is
       compiled into this project rather than duplicated or given a dedicated csproj. -->
  <ItemGroup>
    <Compile Include="..\Config\**\*.cs" LinkBase="Config" />
    <None Include="..\Config\sources.json" Link="Config\sources.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\ApplicationLedger\**\*.cs" LinkBase="ApplicationLedger" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <UserSecretsId>64c15329-c5ef-4981-9ab4-6036a26843d6</UserSecretsId>
  </PropertyGroup>

</Project>
