<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GraphEngine\GraphEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- src/Config, src/ApplicationLedger and src/Notifications are not their own
       projects; their source is compiled into this project rather than duplicated or
       given a dedicated csproj each. -->
  <ItemGroup>
    <Compile Include="..\Config\**\*.cs" LinkBase="Config" />
    <None Include="..\Config\sources.json" Link="Config\sources.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Config\sources.yaml" Link="Config\sources.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\ApplicationLedger\**\*.cs" LinkBase="ApplicationLedger" />
    <Compile Include="..\Notifications\**\*.cs" LinkBase="Notifications" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
