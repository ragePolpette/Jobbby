<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Host\Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- sources.json lives in src/Config; the web host reads it from its output directory, like the CLI. -->
    <None Include="..\Config\sources.json" Link="sources.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same store as the CLI (src/Host): one set of secrets for both. -->
    <UserSecretsId>64c15329-c5ef-4981-9ab4-6036a26843d6</UserSecretsId>
  </PropertyGroup>

</Project>
