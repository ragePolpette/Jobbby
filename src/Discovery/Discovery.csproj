<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GraphEngine\GraphEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Only ConfigLoader.cs, not the whole Config folder: SourceWhitelist is a job-search
       concept (source/whitelist), and Discovery must stay domain-agnostic. -->
  <ItemGroup>
    <Compile Include="..\Config\ConfigLoader.cs" LinkBase="Config" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
